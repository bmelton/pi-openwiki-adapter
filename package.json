{
  "name": "pi-openwiki-adapter",
  "version": "0.7.0",
  "description": "Pi package that exposes generated OpenWiki docs (OKF front matter, quickstart, indexes) as token-efficient codebase navigation tools, with freshness from OpenWiki's own run records.",
  "license": "MIT",
  "author": "bmelton",
  "homepage": "https://github.com/bmelton/pi-openwiki-adapter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bmelton/pi-openwiki-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/bmelton/pi-openwiki-adapter/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "openwiki",
    "langchain",
    "codebase-navigation"
  ],
  "files": [
    "extensions",
    "skills",
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
